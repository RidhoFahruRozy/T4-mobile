<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.studentdirectoryapp.ui.home.HomeFragment"
        android:label="Beranda"
        tools:layout="@layout/fragment_home">
        <action android:id="@+id/action_homeFragment_to_detailFragment" app:destination="@id/detailFragment" />
        <action android:id="@+id/action_homeFragment_to_formFragment" app:destination="@id/formFragment" />
    </fragment>

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.studentdirectoryapp.ui.search.SearchFragment"
        android:label="Cari"
        tools:layout="@layout/fragment_search">
        <action android:id="@+id/action_searchFragment_to_detailFragment" app:destination="@id/detailFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.studentdirectoryapp.ui.profile.ProfileFragment"
        android:label="Profil"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/detailFragment"
        android:name="com.example.studentdirectoryapp.ui.detail.DetailFragment"
        android:label="Detail Mahasiswa"
        tools:layout="@layout/fragment_detail">
        <argument android:name="studentId" app:argType="integer" android:defaultValue="0" />
    </fragment>

    <fragment
        android:id="@+id/formFragment"
        android:name="com.example.studentdirectoryapp.ui.form.FormFragment"
        android:label="Form Mahasiswa"
        tools:layout="@layout/fragment_form">
        <argument android:name="isEdit" app:argType="boolean" android:defaultValue="false" />
        <argument android:name="studentId" app:argType="integer" android:defaultValue="0" />
    </fragment>
</navigation>
